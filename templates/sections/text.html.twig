{% set id = 'panel-' ~ index %}
{% set image = section.text_image ? page.media[section.text_image] : null %}
{% set align = section.text_align|default('right') %}
{% set bg = section.text_background|default('transparent') %}
{% if bg == 'none' %}{% set bg = 'transparent' %}{% endif %}

<section id="{{ id|e('html_attr') }}" class="textImage bg-{{ bg|e('html_attr') }} box-{{ align|e('html_attr') }}">
    <div class="container">
        <div class="text">
            {% if section.text_body %}
                <div class="bb-panel-text-body">{{ section.text_body|bb_markdown|raw }}</div>
            {% endif %}
        </div>
        {% if image %}
        <div class="image">
            <figure class="bb-panel-text-media">
                {{ image.html|raw }}
            </figure>
        </div>
        {% endif %}
    </div>
</section>
