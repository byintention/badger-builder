{% set id = 'panel-' ~ index %}
{% set valign = section.boxes_valign|default('stretch') %}
{% set bg = section.boxes_background|default('transparent') %}
{% if bg == 'none' %}{% set bg = 'transparent' %}{% endif %}
{% set overall = section.boxes_overall_classes|default('') %}
{% set container = section.boxes_container_classes|default('') %}

<section id="{{ id|e('html_attr') }}" class="boxes bb-section bb-panel-boxes bg-{{ bg|e('html_attr') }}{% if overall %} {{ overall|e('html_attr') }}{% endif %}">
    <div class="container">
        {% if section.boxes %}
            <div class="uk-flex bb-panel-boxes-align-{{ valign|e('html_attr') }} inner{% if container %} {{ container|e('html_attr') }}{% endif %}" uk-grid>
            {% for box in section.boxes %}
            <div class="box {% if box.classes %} {{ box.classes|e('html_attr') }}{% endif %}">   
                {% if box.body %}
                    {{ box.body|bb_markdown|raw }}
                {% endif %}    
            </div>
            {% endfor %}
            </div>
        {% endif %}
    </div>
</section>
