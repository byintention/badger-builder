{% set id = 'panel-' ~ index %}
{% set width = section.full_width|default(100) %}
{% set bg = section.full_background|default('transparent') %}
{% if bg == 'none' %}{% set bg = 'transparent' %}{% endif %}
{% set overall = section.full_overall_classes|default('') %}

<section id="{{ id|e('html_attr') }}" class="full bg-{{ bg|e('html_attr') }}{% if overall %} {{ overall|e('html_attr') }}{% endif %}">
    <div class="container">
        <div class="text" style="max-width: {{ width|e('html_attr') }}%;">
            {% if section.full_body %}
               {{ section.full_body|bb_markdown|raw }}
            {% endif %}
        </div>
    </div>
</section>
